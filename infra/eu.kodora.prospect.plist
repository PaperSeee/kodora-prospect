<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>eu.kodora.prospect</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/npm</string>
    <string>run</string>
    <string>start</string>
  </array>
  <!-- Dossier PERSISTANT : plus jamais /tmp, que macOS purge périodiquement
       (c'est ce qui a effacé l'app, la base et le .env.local la dernière fois). -->
  <key>WorkingDirectory</key>
  <string>/Users/paperhq/seo-run/sites/kodora-prospect</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- Anti-boucle : si le process meurt en moins de 30s, launchd attend avant
       de relancer au lieu de spammer le log toutes les 10 secondes. -->
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>/Users/paperhq/Library/Logs/kodora-prospect.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/paperhq/Library/Logs/kodora-prospect.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>DATABASE_URL</key>
    <string>file:/Users/paperhq/seo-run/sites/kodora-prospect/kodora.db</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
