generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Prospect {
  id          Int      @id @default(autoincrement())
  nom         String
  secteur     String
  ville       String   @default("Bruxelles")
  telephone   String?
  email       String?
  siteWeb     String?
  note        Float?
  avis        Int?
  statut      String   @default("a_contacter")
  score       Int      @default(0)
  angle       String?
  goldStar    Boolean  @default(false)

  // Diagnostic stocké en JSON sérialisé
  diagnostic  String?

  // Email généré par IA
  emailObjet  String?
  emailCorps  String?
  emailHtml   String?

  // Notes perso CRM
  notes       String?

  // Tracking ouvertures et séquence de suivi (value ladder, 4 messages
  // espacés J0/J+3/J+7/J+12 — voir lib/email-templates.ts). sequenceStep
  // compte le dernier message envoyé (0 = seulement l'email 1, jusqu'à 3 =
  // les 4 messages envoyés) ; relancee/relanceeAt gardent la date du
  // dernier envoi de suivi pour calculer le prochain délai.
  emailOuvert   Boolean   @default(false)
  emailOuvertAt DateTime?
  sequenceStep  Int       @default(0)
  relancee      Boolean   @default(false)
  relanceeAt    DateTime?

  // RDV : exclusivement manuel (voir /api/prospects/[id]), jamais déduit
  // d'un clic ou d'une vue. rdvAt est obligatoire pour passer statut="rdv".
  rdvAt         DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  audits        Audit[]
  emailEvents   EmailEvent[]
  sendAttempts  SendAttempt[]
}

// Journal brut de chaque événement webhook Brevo reçu, sans exception.
// Source de vérité : les champs du prospect (statut, etc.) n'en sont
// qu'une projection recalculable. Rien n'est jamais écrit sur le prospect
// sans passer par ici en premier (sauf actions manuelles explicites).
model EmailEvent {
  id         Int      @id @default(autoincrement())
  prospectId Int?
  prospect   Prospect? @relation(fields: [prospectId], references: [id])
  messageId  String?
  event      String    // delivered | hard_bounce | soft_bounce | blocked | deferred | complaint | opened | clicked | unsubscribed | ...
  payload    String    // JSON brut de l'événement Brevo, pour audit / rejeu
  receivedAt DateTime  @default(now())

  @@index([messageId])
  @@index([prospectId])
}

// Chaque tentative d'envoi, réussie ou non. Rend visible ce qui était
// invisible avant : un run qui échoue silencieusement (catch + console.error).
model SendAttempt {
  id         Int      @id @default(autoincrement())
  prospectId Int
  prospect   Prospect @relation(fields: [prospectId], references: [id])
  startedAt  DateTime @default(now())
  httpStatus Int?
  messageId  String?
  error      String?

  @@index([prospectId])
  @@index([messageId])
}

model EarlyAccessSignup {
  id        String   @id @default(cuid())
  email     String   @unique
  url       String?
  createdAt DateTime @default(now())
}

// Trace chaque exécution du pipeline auto (source → génère → envoie).
// Sert aussi à compter les envois du jour pour respecter le plafond / ramp.
model PipelineRun {
  id          Int      @id @default(autoincrement())
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  sourced     Int      @default(0)  // nouveaux prospects sourcés
  generated   Int      @default(0)  // emails générés
  sent        Int      @default(0)  // emails réellement envoyés (res.ok Brevo, avant confirmation delivered)
  eligible    Int      @default(0)  // prospects qui remplissaient les critères d'envoi ce run
  failed      Int      @default(0)  // tentatives échouées (res non-ok ou exception)
  capUsed     Int      @default(0)  // plafond appliqué ce jour-là
  status      String   @default("running") // running | done | error
  error       String?
}

model Audit {
  id                   String    @id @default(cuid())
  prospectId           Int
  prospect             Prospect  @relation(fields: [prospectId], references: [id])
  publicSlug           String    @unique
  score                Int
  problemesJson        String    // JSON sérialisé (SQLite pas de Json natif)
  rapportJson          String?   // snapshot complet AuditResult sérialisé
  generatedAt          DateTime  @default(now())
  firstViewedAt        DateTime?
  lastViewedAt         DateTime?
  viewCount            Int       @default(0)
  ctaClicked           Boolean   @default(false)
  ctaClickedAt         DateTime?
  emailCapturedAt      DateTime?
  emailCaptured        String?
}
